@{
    var rejected = ViewBag.Rejected == true;
    ViewData["Title"] = rejected ? "Registration Not Approved" : "Account Pending Approval";
}

<section>
    <div class="container" style="max-width:560px;">
        <div class="card" style="padding:44px 36px; text-align:center;">
            @if (rejected)
            {
                <div class="feature-icon" style="margin:0 auto 20px; width:68px; height:68px; font-size:1.6rem; border-radius:50%; background:var(--danger-tint); color:var(--danger);">
                    <i class="fa-solid fa-user-xmark"></i>
                </div>
                <h1 style="font-size:1.6rem; margin-bottom:12px;">Your registration was not approved</h1>
                <p class="section-sub" style="margin:0 auto 28px;">
                    Our team reviewed this farmer account and could not approve it. If you think this is a mistake,
                    please contact us at hello&#64;farmmitra.in.
                </p>
            }
            else
            {
                <div class="feature-icon" style="margin:0 auto 20px; width:68px; height:68px; font-size:1.6rem; border-radius:50%;">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>
                <h1 style="font-size:1.6rem; margin-bottom:12px;">Your account is awaiting approval</h1>
                <p class="section-sub" style="margin:0 auto 28px;">
                    Thanks for joining Farm Mitra. Our team reviews every farmer account before it goes live.
                    You will be able to log in and start listing products as soon as it is approved.
                </p>
            }
            <a href="~/" class="btn btn-primary">Back to Home</a>
        </div>
    </div>
</section>
