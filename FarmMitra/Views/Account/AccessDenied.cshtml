@{
    ViewData["Title"] = "Access Denied";
}

<section>
    <div class="container" style="max-width:560px;">
        <div class="card" style="padding:44px 36px; text-align:center;">
            <div class="feature-icon" style="margin:0 auto 20px; width:68px; height:68px; font-size:1.6rem; border-radius:50%; background:var(--danger-tint); color:var(--danger);">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h1 style="font-size:1.6rem; margin-bottom:12px;">Access denied</h1>
            <p class="section-sub" style="margin:0 auto 28px;">
                Your account doesn't have permission to open this page.
            </p>
            <a href="~/" class="btn btn-primary">Back to Home</a>
        </div>
    </div>
</section>
