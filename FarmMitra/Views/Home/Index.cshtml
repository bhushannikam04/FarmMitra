<!-- ============ SAVINGS CALCULATOR ============ -->
<section id="savings" style="background:var(--background);">
    <div class="container">
        <div class="fx-head">
            <span class="eyebrow">See the difference</span>
            <h2 class="section-heading">What does skipping the middleman save you?</h2>
            <p class="section-sub">Pick a real listing, set your quantity and slide the markup a typical wholesale-to-retail chain adds. The farmer's price is the one actually listed.</p>
        </div>
        @if (ticker.Any())
        {
            <div class="fx-card calc" id="calc" data-items="@tickerJson">
                <div class="calc-in">
                    <div>
                        <label for="calc-product">Product</label>
                        <select id="calc-product"></select>
                    </div>
                    <div class="calc-row">
                        <div>
                            <label for="calc-qty">Quantity</label>
                            <input id="calc-qty" type="number" min="1" max="100000" value="10" />
                        </div>
                        <div>
                            <label for="calc-markup">Middleman markup: <span id="calc-markup-val">35</span>%</label>
                            <input id="calc-markup" type="range" min="10" max="80" value="35" />
                        </div>
                    </div>
                    <p class="calc-note">The markup is an assumption you control: goods usually pass through several hands before reaching a shop shelf. Farm Mitra's prices are set by the farmer and shown before you order.</p>
                </div>
                <div class="calc-out" aria-live="polite">
                    <div class="calc-bars">
                        <div class="cb-farm">
                            <div class="cb-top"><span>Buy direct on Farm Mitra</span><b id="calc-direct">-</b></div>
                            <div class="cb-track"><i id="calc-bar-direct"></i></div>
                        </div>
                        <div class="cb-mkt">
                            <div class="cb-top"><span>Typical market price</span><b id="calc-market">-</b></div>
                            <div class="cb-track"><i id="calc-bar-market"></i></div>
                        </div>
                    </div>
                    <div class="calc-save">
                        <div><span>You could save</span><br /><strong id="calc-save">-</strong></div>
                        <a href="~/Marketplace" class="btn btn-accent">Shop direct</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="fx-card calc-empty">Listings will appear here as soon as farmers add products.</div>
        }
    </div>
</section>

