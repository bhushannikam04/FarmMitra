<script>
    // Savings calculator + seasonal calendar
    (function () {
        var RUPEE = '\u20B9';
        function money(n) { return RUPEE + Math.round(n).toLocaleString('en-IN'); }

        /* ---- calculator ---- */
        var box = document.getElementById('calc');
        if (box) {
            var items = [];
            try { items = JSON.parse(box.dataset.items || '[]'); } catch (e) { }
            var sel = document.getElementById('calc-product'), qty = document.getElementById('calc-qty'),
                mk = document.getElementById('calc-markup'), mkv = document.getElementById('calc-markup-val');
            items.forEach(function (it, i) {
                var o = document.createElement('option'); o.value = i;
                o.textContent = it.Name + ' (' + RUPEE + it.Price + '/' + it.Unit + ')'; sel.appendChild(o);
            });
            function calc() {
                var it = items[+sel.value]; if (!it) return;
                var q = Math.max(1, Math.min(100000, parseFloat(qty.value) || 1));
                var pct = +mk.value; mkv.textContent = pct;
                var direct = it.Price * q, market = direct * (1 + pct / 100);
                document.getElementById('calc-direct').textContent = money(direct);
                document.getElementById('calc-market').textContent = money(market);
                document.getElementById('calc-save').textContent = money(market - direct);
                document.getElementById('calc-bar-direct').style.width = (direct / market * 100).toFixed(1) + '%';
                document.getElementById('calc-bar-market').style.width = '100%';
            }
            [sel, qty, mk].forEach(function (el) { el.addEventListener('input', calc); });
            calc();
        }

        /* ---- seasonal calendar ---- */
        var tabs = document.getElementById('season-tabs'), chips = document.getElementById('season-chips');
        if (tabs && chips) {
            var M = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
            var CROPS = [
                [['Peas','\uD83E\uDD5B'],['Carrot','\uD83E\uDD55'],['Cauliflower','\uD83E\uDD66'],['Spinach','\uD83E\uDD6C'],['Orange','\uD83C\uDF4A'],['Guava','\uD83C\uDF48']],
                [['Cabbage','\uD83E\uDD6C'],['Tomato','\uD83C\uDF45'],['Strawberry','\uD83C\uDF53'],['Orange','\uD83C\uDF4A'],['Beetroot','\uD83E\uDD55'],['Radish','\uD83E\uDD55']],
                [['Watermelon','\uD83C\uDF49'],['Grapes','\uD83C\uDF47'],['Cucumber','\uD83E\uDD52'],['Wheat','\uD83C\uDF3E'],['Green chilli','\uD83C\uDF36\uFE0F'],['Muskmelon','\uD83C\uDF48']],
                [['Mango','\uD83E\uDD6D'],['Watermelon','\uD83C\uDF49'],['Grapes','\uD83C\uDF47'],['Cucumber','\uD83E\uDD52'],['Lemon','\uD83C\uDF4B'],['Wheat','\uD83C\uDF3E']],
                [['Mango','\uD83E\uDD6D'],['Litchi','\uD83C\uDF52'],['Watermelon','\uD83C\uDF49'],['Jackfruit','\uD83C\uDF48'],['Lemon','\uD83C\uDF4B'],['Bottle gourd','\uD83E\uDD52']],
                [['Mango','\uD83E\uDD6D'],['Jamun','\uD83C\uDF47'],['Okra','\uD83E\uDD52'],['Brinjal','\uD83C\uDF46'],['Pineapple','\uD83C\uDF4D'],['Litchi','\uD83C\uDF52']],
                [['Corn','\uD83C\uDF3D'],['Okra','\uD83E\uDD52'],['Bitter gourd','\uD83E\uDD52'],['Pear','\uD83C\uDF50'],['Papaya','\uD83C\uDF48'],['Plum','\uD83C\uDF51']],
                [['Corn','\uD83C\uDF3D'],['Pomegranate','\uD83C\uDF4E'],['Apple','\uD83C\uDF4E'],['Pear','\uD83C\uDF50'],['Ridge gourd','\uD83E\uDD52'],['Papaya','\uD83C\uDF48']],
                [['Pomegranate','\uD83C\uDF4E'],['Apple','\uD83C\uDF4E'],['Banana','\uD83C\uDF4C'],['Guava','\uD83C\uDF48'],['Corn','\uD83C\uDF3D'],['Sweet potato','\uD83C\uDF60']],
                [['Rice','\uD83C\uDF3E'],['Pomegranate','\uD83C\uDF4E'],['Guava','\uD83C\uDF48'],['Custard apple','\uD83C\uDF48'],['Cauliflower','\uD83E\uDD66'],['Sweet lime','\uD83C\uDF4B']],
                [['Cauliflower','\uD83E\uDD66'],['Peas','\uD83E\uDD5B'],['Carrot','\uD83E\uDD55'],['Sweet lime','\uD83C\uDF4B'],['Radish','\uD83E\uDD55'],['Potato','\uD83E\uDD54']],
                [['Carrot','\uD83E\uDD55'],['Peas','\uD83E\uDD5B'],['Orange','\uD83C\uDF4A'],['Cabbage','\uD83E\uDD6C'],['Spinach','\uD83E\uDD6C'],['Onion','\uD83E\uDDC5']]
            ];
            var now = new Date().getMonth();
            function show(m) {
                Array.prototype.forEach.call(tabs.children, function (b, i) { b.classList.toggle('on', i === m); b.setAttribute('aria-selected', i === m); });
                chips.innerHTML = '';
                CROPS[m].forEach(function (c, i) {
                    var d = document.createElement('div'); d.className = 'season-chip'; d.style.animationDelay = (i * 55) + 'ms';
                    var s = document.createElement('span'); s.textContent = c[1]; d.appendChild(s);
                    d.appendChild(document.createTextNode(c[0])); chips.appendChild(d);
                });
            }
            M.forEach(function (n, i) {
                var b = document.createElement('button'); b.type = 'button'; b.textContent = n; b.setAttribute('role', 'tab');
                if (i === now) b.className = 'now';
                b.addEventListener('click', function () { show(i); }); tabs.appendChild(b);
            });
            show(now);
        }
    })();
</script>

<script>
    // Background video: plays on its own, loops forever, and keeps playing (resumes after tab switches or a blocked autoplay).
    (function () {
        var v = document.getElementById('hero-video'), hero = document.getElementById('home'), btn = document.getElementById('hero-video-toggle');
        if (!v || !hero) return;
        var conn = navigator.connection || {};
        var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (conn.saveData) { v.remove(); return; }                      // data saver: keep the plain hero
        v.muted = true; v.defaultMuted = true; v.setAttribute('muted', '');
        var wanted = !calm, visible = true;                              // 'wanted' is false while the visitor has paused it

        function showVideo() { hero.classList.add('has-video'); }
        if (v.readyState >= 2) showVideo(); else v.addEventListener('loadeddata', showVideo, { once: true });

        function play() {
            if (!wanted || !visible || document.hidden) return;
            var p = v.play();
            if (p && p.catch) p.catch(function () {                      // autoplay blocked: start on the first touch, key or click
                var go = function () { ['pointerdown', 'keydown', 'touchstart'].forEach(function (e) { removeEventListener(e, go); }); play(); };
                ['pointerdown', 'keydown', 'touchstart'].forEach(function (e) { addEventListener(e, go, { once: true }); });
            });
        }
        function setIcon() {
            if (!btn) return;
            var paused = !wanted;
            btn.innerHTML = '<i class="fa-solid ' + (paused ? 'fa-play' : 'fa-pause') + '"></i>';
            btn.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
        }

        v.addEventListener('pause', function () { if (wanted && visible && !document.hidden && !v.ended) setTimeout(play, 250); });
        v.addEventListener('ended', function () { v.currentTime = 0; play(); });   // safety net if loop is ignored
        document.addEventListener('visibilitychange', function () { if (document.hidden) v.pause(); else play(); });
        if ('IntersectionObserver' in window) {
            new IntersectionObserver(function (es) {
                visible = es[0].isIntersecting;
                if (visible) play(); else v.pause();                     // saves battery while the hero is off screen
            }, { threshold: 0.05 }).observe(hero);
        }
        if (btn) btn.addEventListener('click', function () { wanted = !wanted; if (wanted) play(); else v.pause(); setIcon(); });

        setIcon();
        if (wanted) play();
    })();
</script>

