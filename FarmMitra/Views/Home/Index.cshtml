<!-- ============ LIVE PRICE STRIP ============ -->
@if (ticker.Any())
{
    <div class="price-ticker" aria-label="Live prices set by farmers">
        <div class="pt-label"><i class="live-dot"></i> Farm prices</div>
        <div class="pt-track">
            @for (var pass = 0; pass < 2; pass++)
            {
                foreach (var it in ticker)
                {
                    <span class="pt-item" aria-hidden="@(pass == 1 ? "true" : "false")"><b>@it.Name</b> <em>&#8377;@it.Price.ToString("0.##")/@it.Unit</em> @if (!string.IsNullOrWhiteSpace(it.Location)) { <small>@it.Location</small> }</span>
                }
            }
        </div>
    </div>
}

<!-- ============ MARKETPLACE (horizontal scroll) ============ -->
<section id="marketplace" style="background:var(--white);">
