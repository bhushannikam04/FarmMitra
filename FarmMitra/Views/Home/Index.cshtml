<script>
    // Refreshes the farmer section every 30 seconds while the tab is visible.
    (function () {
        var box = document.getElementById('farmer-live');
        var stamp = document.getElementById('farmer-live-time');
        if (!box) return;

        async function refresh() {
            if (document.hidden) return;
            try {
                var res = await fetch(box.dataset.url, { cache: 'no-store' });
                if (!res.ok) return;
                box.innerHTML = await res.text();
                if (stamp) stamp.textContent = 'updated ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            } catch (e) { /* keep showing the last data */ }
        }

        setInterval(refresh, 30000);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
    })();
</script>

