@model List<FarmMitra.Models.Product>
@{
    ViewData["Title"] = "Connecting Farmers. Empowering Agriculture.";
    var stats = ViewData["Stats"] as FarmMitra.ViewModels.HomeStats ?? new FarmMitra.ViewModels.HomeStats();
    var ticker = ViewData["Ticker"] as List<FarmMitra.ViewModels.TickerItem> ?? new List<FarmMitra.ViewModels.TickerItem>();
    var tickerJson = System.Text.Json.JsonSerializer.Serialize(ticker);   // escapes < > & so it is safe inside <script>
}

<style>
    .hero-top { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; margin-bottom: 44px; }
    .hero-top .hero-intro { margin-bottom: 0; }
    .hero-art { position: relative; width: 100%; max-width: 470px; justify-self: end; }
    .hero-svg { display: block; width: 100%; height: auto; border-radius: 28px; box-shadow: var(--shadow-lg); }
    .hero-art .floating-card-top { top: 26px; right: -10px; }
    .hero-art .floating-card-bottom { bottom: 6px; left: -14px; }
    .bento-photo { background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
    @@media (max-width: 900px) {
        .hero-top { grid-template-columns: 1fr; gap: 32px; }
        .hero-art { justify-self: center; max-width: 420px; }
        .hero-art .floating-card-top { right: 6px; }
        .hero-art .floating-card-bottom { left: 6px; }
    }

    /* How it works */
    .hiw { background: var(--white); }
    .hiw-head { text-align: center; max-width: 620px; margin: 0 auto 48px; }
    .hiw-head .section-sub { margin-left: auto; margin-right: auto; }
    .hiw-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; position: relative; counter-reset: none; }
    .hiw-steps::before { content: ""; position: absolute; top: 62px; left: 12%; right: 12%; border-top: 2px dashed var(--secondary); z-index: 0; }
    .hiw-step { position: relative; z-index: 1; background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28px 22px 26px; text-align: center; overflow: hidden; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
    .hiw-step:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: var(--secondary); }
    .hiw-num { position: absolute; top: 8px; right: 16px; font-family: var(--font-display); font-weight: 700; font-size: 2.6rem; line-height: 1; color: var(--primary); opacity: .09; }
    .hiw-icon { width: 68px; height: 68px; margin: 0 auto 18px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; box-shadow: 0 0 0 8px var(--background), 0 8px 18px rgba(27, 94, 32, .25); }
    .hiw-step h3 { font-size: 1.08rem; margin-bottom: 8px; }
    .hiw-step p { color: var(--text-light); font-size: .9rem; margin: 0; }
    .hiw-cta { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-top: 44px; }
    @@media (max-width: 1000px) { .hiw-steps { grid-template-columns: repeat(2, 1fr); } .hiw-steps::before { display: none; } }
    @@media (max-width: 560px) { .hiw-steps { grid-template-columns: 1fr; } .hiw-cta .btn { width: 100%; } }

    /* Live farmers + loyalty */
    .live-pill { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; background: var(--primary-tint); color: var(--primary-dark); font-weight: 600; font-size: .82rem; }
    .live-pill small { font-weight: 500; color: var(--text-light); }
    .live-dot { width: 9px; height: 9px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,.6); animation: livepulse 1.8s infinite; }
    @@keyframes livepulse { 70% { box-shadow: 0 0 0 9px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }

    .fl-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 24px; align-items: stretch; }
    .fl-top { background: linear-gradient(135deg, var(--primary-dark), var(--primary)); color: #fff; border-radius: var(--radius-lg); padding: 30px; display: flex; flex-direction: column; gap: 18px; }
    .fl-top-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
    .fl-eyebrow { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; opacity: .8; }
    .fl-top-id { display: flex; align-items: center; gap: 16px; }
    .fl-top-id h3 { color: #fff; font-size: 1.5rem; margin: 0 0 4px; }
    .fl-loc { display: flex; align-items: center; gap: 6px; font-size: .86rem; color: var(--text-light); }
    .fl-top .fl-loc { color: rgba(255,255,255,.8); }
    .fl-loc i { font-size: .8rem; }
    .fl-avatar { width: 52px; height: 52px; border-radius: 50%; background: var(--primary-tint); color: var(--primary); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; flex-shrink: 0; }
    .fl-avatar-lg { width: 76px; height: 76px; font-size: 1.9rem; background: #fff; box-shadow: 0 0 0 5px rgba(255,255,255,.22); }
    .fl-avatar { overflow: hidden; }
    .fl-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .fl-crops { display: flex; flex-wrap: wrap; gap: 8px; }
    .fl-crops span { background: rgba(255,255,255,.16); padding: 5px 12px; border-radius: 999px; font-size: .8rem; }
    .fl-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .fl-stats div { background: rgba(255,255,255,.12); border-radius: var(--radius-md); padding: 14px 10px; text-align: center; }
    .fl-stats strong { display: block; font-family: var(--font-display); font-size: 1.5rem; line-height: 1.1; }
    .fl-stats span { font-size: .74rem; opacity: .8; }
    .fl-bar { height: 8px; border-radius: 99px; background: rgba(255,255,255,.2); overflow: hidden; }
    .fl-bar i { display: block; height: 100%; border-radius: 99px; background: var(--accent); transition: width .6s ease; }
    .fl-progress small { display: block; margin-top: 6px; opacity: .85; font-size: .78rem; }
    .fl-foot { display: flex; gap: 18px; flex-wrap: wrap; font-size: .84rem; opacity: .9; margin-top: auto; }
    .fl-foot i { margin-right: 6px; }

    .fl-badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; font-weight: 700; font-size: .78rem; }
    .fl-badge-sm { padding: 3px 10px; font-size: .72rem; }
    .tier-seedling { background: #e8f3e9; color: #1b5e20; }
    .tier-bronze { background: #f6e3d3; color: #8a4b1c; }
    .tier-silver { background: #e5e9ef; color: #475569; }
    .tier-gold { background: #fdecb6; color: #8a5a00; }

    .fl-list { display: flex; flex-direction: column; gap: 14px; }
    .fl-card { display: flex; gap: 14px; align-items: flex-start; background: var(--background); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 16px 18px; flex: 1; transition: box-shadow .2s ease, transform .2s ease; }
    .fl-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .fl-card-body { flex: 1; min-width: 0; }
    .fl-card-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .fl-card h3 { font-size: .98rem; margin: 0; }
    .fl-mini { display: flex; gap: 14px; flex-wrap: wrap; font-size: .78rem; color: var(--text-light); margin: 8px 0 8px; }
    .fl-mini strong { color: var(--text-dark); }
    .fl-card .fl-bar { background: var(--border); }
    .fl-card .fl-bar i { background: var(--primary-light); }
    .fl-bar-sm { height: 6px; }
    .fl-card-note p { margin: 4px 0 0; color: var(--text-light); font-size: .88rem; }
    .fl-empty { text-align: center; padding: 48px 20px; background: var(--background); border: 1px dashed var(--border); border-radius: var(--radius-lg); }
    .fl-empty i { font-size: 2rem; color: var(--primary-light); margin-bottom: 10px; }
    .fl-empty p { color: var(--text-light); margin: 6px auto 18px; max-width: 420px; }
    @@media (max-width: 900px) { .fl-grid { grid-template-columns: 1fr; } }
    @@media (max-width: 480px) { .fl-stats { grid-template-columns: 1fr 1fr 1fr; gap: 8px; } .fl-stats strong { font-size: 1.2rem; } }
</style>


<style>
    /* ---------- live price strip ---------- */
    .price-ticker { background: var(--primary-dark); color: #fff; overflow: hidden; position: relative; border-block: 1px solid rgba(255,255,255,.08); }
    .price-ticker .pt-label { position: absolute; left: 0; top: 0; bottom: 0; z-index: 2; display: flex; align-items: center; gap: 8px; padding: 0 18px 0 max(16px, calc((100vw - var(--container-width)) / 2));
        background: linear-gradient(90deg, var(--primary-dark) 78%, transparent); font-weight: 700; font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
    .pt-track { display: flex; width: max-content; padding: 13px 0 13px 190px; animation: ptscroll 48s linear infinite; }
    .price-ticker:hover .pt-track { animation-play-state: paused; }
    .pt-item { display: inline-flex; align-items: baseline; gap: 8px; padding: 0 26px; white-space: nowrap; font-size: .9rem; border-right: 1px solid rgba(255,255,255,.14); }
    .pt-item b { font-family: var(--font-display); font-weight: 600; }
    .pt-item em { font-style: normal; color: #FFD66B; font-weight: 700; }
    .pt-item small { opacity: .65; }
    @@keyframes ptscroll { to { transform: translateX(-50%); } }
    @@media (prefers-reduced-motion: reduce) { .pt-track { animation: none; overflow-x: auto; } }

    /* ---------- shared card look for the new sections ---------- */
    .fx-head { text-align: center; max-width: 660px; margin: 0 auto 38px; }
    .fx-head .section-sub { margin-left: auto; margin-right: auto; }
    .fx-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }

    /* ---------- savings calculator ---------- */
    .calc { display: grid; grid-template-columns: 1fr 1.1fr; overflow: hidden; }
    .calc-in { padding: 32px; display: flex; flex-direction: column; gap: 20px; }
    .calc-in label { display: block; font-weight: 600; font-size: .86rem; margin-bottom: 7px; }
    .calc-in select, .calc-in input[type=number] { width: 100%; padding: 12px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-md); background: var(--background); color: var(--text-dark); font: inherit; }
    .calc-in input[type=range] { width: 100%; accent-color: var(--primary-light); }
    .calc-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .calc-note { font-size: .78rem; color: var(--text-light); margin: 0; line-height: 1.5; }
    .calc-out { background: linear-gradient(145deg, var(--primary-dark), var(--primary)); color: #fff; padding: 32px; display: flex; flex-direction: column; gap: 18px; justify-content: center; }
    .calc-bars { display: flex; flex-direction: column; gap: 14px; }
    .cb-top { display: flex; justify-content: space-between; font-size: .84rem; margin-bottom: 6px; }
    .cb-top b { font-family: var(--font-display); font-size: 1.05rem; }
    .cb-track { height: 14px; border-radius: 99px; background: rgba(255,255,255,.16); overflow: hidden; }
    .cb-track i { display: block; height: 100%; border-radius: 99px; width: 0; transition: width .6s var(--ease); }
    .cb-farm i { background: #8BE28F; }
    .cb-mkt i { background: #FFB74D; }
    .calc-save { background: rgba(255,255,255,.12); border-radius: var(--radius-md); padding: 16px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    .calc-save strong { font-family: var(--font-display); font-size: 1.9rem; line-height: 1; color: #FFD66B; }
    .calc-save span { font-size: .84rem; opacity: .85; }
    .calc-empty { padding: 40px; text-align: center; color: var(--text-light); }
    @@media (max-width: 860px) { .calc { grid-template-columns: 1fr; } .calc-in, .calc-out { padding: 24px; } }

    /* ---------- seasonal calendar ---------- */
    .season-tabs { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: 26px; }
    .season-tabs button { border: 1.5px solid var(--border); background: var(--white); color: var(--text-dark); padding: 8px 15px; border-radius: 999px; font: inherit; font-weight: 600; font-size: .84rem; cursor: pointer; transition: all .2s var(--ease); }
    .season-tabs button:hover { border-color: var(--primary-light); }
    .season-tabs button.on { background: var(--primary); border-color: var(--primary); color: #fff; }
    .season-tabs button.now::after { content: ""; display: inline-block; width: 6px; height: 6px; margin-left: 7px; border-radius: 50%; background: var(--accent); vertical-align: middle; }
    .fx-chip-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; min-height: 64px; }
    .season-chip { display: inline-flex; align-items: center; gap: 10px; padding: 12px 20px; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); font-weight: 600; animation: chipin .35s var(--ease) both; }
    .season-chip span { font-size: 1.4rem; line-height: 1; }
    @@keyframes chipin { from { opacity: 0; transform: translateY(8px) scale(.96); } }
    .season-foot { text-align: center; margin-top: 22px; font-size: .8rem; color: var(--text-light); }

    /* ---------- three roles ---------- */
    .roles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .role-card { padding: 28px 26px; position: relative; overflow: hidden; transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
    .role-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
    .role-ico { width: 54px; height: 54px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: #fff; margin-bottom: 16px; background: linear-gradient(135deg, var(--primary), var(--primary-light)); }
    .role-card.r-admin .role-ico { background: linear-gradient(135deg, #1D4ED8, #60A5FA); }
    .role-card.r-buyer .role-ico { background: linear-gradient(135deg, #E08E00, #F9A825); }
    .role-card h3 { margin: 0 0 10px; }
    .role-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
    .role-card li { display: flex; gap: 10px; font-size: .9rem; color: var(--text-light); line-height: 1.45; }
    .role-card li i { color: var(--primary-light); margin-top: 3px; font-size: .8rem; }
    @@media (max-width: 900px) { .roles { grid-template-columns: 1fr; } }

    /* ---------- FAQ ---------- */
    .faq { max-width: 780px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px; }
    .faq-item { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; }
    .faq-item summary { list-style: none; cursor: pointer; padding: 18px 22px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; gap: 14px; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: "+"; font-size: 1.4rem; line-height: 1; color: var(--primary-light); transition: transform .25s var(--ease); }
    .faq-item[open] summary::after { transform: rotate(45deg); }
    .faq-item[open] { border-color: var(--secondary); }
    .faq-item p { margin: 0; padding: 0 22px 20px; color: var(--text-light); line-height: 1.65; }
</style>


<style>
    /* ---------- looping video behind the hero ---------- */
    .hero { position: relative; overflow: hidden; isolation: isolate; }
    .hero > .container { position: relative; z-index: 2; }
    .hero-video-wrap { position: absolute; inset: 0; z-index: 0; opacity: 0; transition: opacity 1s var(--ease); pointer-events: none; }
    .hero.has-video .hero-video-wrap { opacity: 1; }
    .hero-video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hero-video-wrap::after { content: ""; position: absolute; inset: 0;
        background: linear-gradient(180deg, rgba(8,38,14,.72) 0%, rgba(10,46,18,.58) 45%, rgba(10,46,18,.78) 100%); }
    .hero.has-video .eyebrow { color: #B9F0BC; }
    .hero.has-video .hero-title { color: #fff; text-shadow: 0 2px 22px rgba(0,0,0,.35); }
    .hero.has-video .hero-sub { color: rgba(255,255,255,.88); }
    .hero.has-video .btn-secondary, .hero.has-video .btn-outline { background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.55); color: #fff; backdrop-filter: blur(6px); }
    .hero-video-toggle { position: absolute; left: 18px; bottom: 16px; z-index: 3; width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgba(255,255,255,.45);
        background: rgba(0,0,0,.35); color: #fff; cursor: pointer; display: none; align-items: center; justify-content: center; backdrop-filter: blur(6px); }
    .hero.has-video .hero-video-toggle { display: flex; }
    .hero-video-toggle:hover { background: rgba(0,0,0,.55); }
    @@media (prefers-reduced-motion: reduce) { .hero-video-wrap { transition: none; } }
</style>

<link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
<script>
    // Apple-style motion: switched on here (before the page paints) so nothing flashes.
    // It is skipped for people who prefer reduced motion, and switched off again if motion.js fails to load.
    (function () {
        var r = document.documentElement;
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        r.classList.add('motion');
        setTimeout(function () { if (!window.__fmMotion) r.classList.remove('motion'); }, 3000);
    })();
</script>

