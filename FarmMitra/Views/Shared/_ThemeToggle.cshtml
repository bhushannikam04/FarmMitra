@* Theme switch button (sun/moon). Used in every layout: <partial name="_ThemeToggle" /> *@
<button type="button" class="btn btn-outline btn-icon theme-toggle" data-theme-toggle aria-label="Switch to dark theme" title="Dark theme">
    <i class="fa-solid fa-moon ico-moon"></i>
    <i class="fa-solid fa-sun ico-sun"></i>
</button>
