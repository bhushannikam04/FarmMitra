@* Language picker: 22 Indian languages + English. Used in every layout: <partial name="_LanguagePicker" /> *@
<div class="lang-picker notranslate" translate="no">
    <button type="button" class="btn btn-outline lang-btn" aria-haspopup="true" aria-expanded="false" aria-label="Change language" title="Language">
        <i class="fa-solid fa-language"></i>
        <span class="lang-label" data-lang-current>English</span>
        <i class="fa-solid fa-chevron-down"></i>
    </button>
    <div class="lang-menu" role="menu" aria-label="Choose language"></div>
</div>
