@model PagedResult<FarmerOrderRow>
@{
    ViewData["Title"] = "Orders";
    ViewData["Placeholder"] = "Search order number, product or buyer...";
    ViewData["Statuses"] = new[] { "Pending", "Confirmed", "Shipped", "Delivered", "Cancelled" };
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="dash-content-head">
    <div>
        <h1>Orders</h1>
        <p>Orders for your products. Confirm, ship and deliver them from here.</p>
    </div>
</div>

<div class="dash-panel">
    <partial name="_ListToolbar" model="(IPaged)Model" />

    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr><th>Order</th><th>Product</th><th>Buyer</th><th>Quantity</th><th>Amount</th><th>Date</th><th>Status</th><th>Next step</th></tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Items)
                {
                    var next = OrderFlow.Next(o.Status);
                    <tr>
                        <td>#FM-@o.OrderId</td>
                        <td>
                            <div class="table-product">
                                <img src="@(string.IsNullOrEmpty(o.ProductImage) ? "/images/placeholder.svg" : o.ProductImage)" alt="" onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
                                @o.ProductName
                            </div>
                        </td>
                        <td>@o.BuyerName</td>
                        <td>@o.Quantity @o.Unit</td>
                        <td>₹@o.Amount.ToString("N0")</td>
                        <td>@o.OrderDate.ToString("dd MMM yyyy")</td>
                        <td><span class="badge @BadgeHelper.Css(o.Status)">@o.Status</span></td>
                        <td>
                            @if (!o.OnlyMine)
                            {
                                <span class="cell-sub" title="This order also has products from other farmers">Managed by admin</span>
                            }
                            else if (next.Length == 0)
                            {
                                <span class="cell-sub">-</span>
                            }
                            else
                            {
                                <form asp-area="Farmer" asp-controller="Orders" asp-action="UpdateStatus" asp-route-id="@o.OrderId" method="post" class="flex gap-8 items-center">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <select name="status" class="input select-sm" aria-label="New status">
                                        @foreach (var s in next)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-secondary btn-sm">Save</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr class="empty-row"><td colspan="8">No orders yet. They'll show up here once buyers order your products.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="(IPaged)Model" />
</div>
